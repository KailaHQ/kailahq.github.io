---
import type { Feature } from '../data/content'
import ScreenShot from './ScreenShot.astro'

interface Props {
  feature: Feature
  /** Odd rows put the screenshot on the left; the page walks down in a zigzag. */
  flip?: boolean
}
const { feature, flip = false } = Astro.props
---

<article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
  <div class={`reveal lg:col-span-5 ${flip ? 'lg:order-2 lg:col-start-8' : ''}`}>
    <div class="flex items-baseline gap-3">
      <span class="timecode text-accent">{feature.tc}</span>
      <span class="h-px flex-1 bg-hairline/60"></span>
      <span class="timecode">{feature.kicker}</span>
    </div>

    <h3 class="mt-6 text-[clamp(1.75rem,3.4vw,2.5rem)]">{feature.title}</h3>
    <p class="mt-5 text-[15.5px] leading-[1.7] text-ash">{feature.body}</p>

    <ul class="mt-7 space-y-3">
      {
        feature.bullets.map((b) => (
          <li class="flex gap-3 text-[14.5px] leading-relaxed text-chalk/85">
            <span
              class="mt-[0.5rem] h-1.5 w-1.5 flex-none rotate-45 bg-accent/80"
              aria-hidden="true"
            />
            <span>{b}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div
    class={`reveal lg:col-span-7 ${flip ? 'lg:order-1 lg:col-start-1' : ''}`}
    style="--reveal-delay:110ms"
  >
    <ScreenShot src={feature.shot} alt={feature.shotAlt} />
  </div>
</article>
