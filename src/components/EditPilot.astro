---
import type { Copy } from '../data/content'
import ScreenShot from './ScreenShot.astro'

interface Props {
  copy: Copy
}
const { copy } = Astro.props
const ep = copy.editpilot
---

<section id="editpilot" class="relative overflow-hidden border-y border-white/5 bg-ink-soft">
  <div
    class="pointer-events-none absolute right-0 top-0 h-[460px] w-[620px] translate-x-1/3 rounded-full bg-ember/8 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-[1240px] px-5 py-24 sm:px-8 sm:py-32">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-5">
        <div class="flex items-baseline gap-3">
          <span class="timecode text-ember">{ep.tc}</span>
          <span class="h-px w-16 bg-hairline/60"></span>
        </div>

        <h2 class="mt-6 whitespace-pre-line text-[clamp(2rem,4.2vw,3rem)]">{ep.title}</h2>
        <p class="mt-6 text-[15.5px] leading-[1.7] text-ash">{ep.body}</p>

        <dl class="mt-10 space-y-7">
          {
            ep.points.map((p) => (
              <div class="border-l border-hairline/70 pl-5">
                <dt class="font-display text-[16px] font-semibold tracking-[-0.02em] text-chalk">
                  {p.title}
                </dt>
                <dd class="mt-2 text-[14px] leading-relaxed text-ash">{p.body}</dd>
              </div>
            ))
          }
        </dl>

        <p class="timecode mt-9 normal-case tracking-[0.08em]">{ep.note}</p>
      </div>

      <div class="reveal lg:col-span-7" style="--reveal-delay:110ms">
        <ScreenShot src={ep.shot} alt={ep.shotAlt} />
      </div>
    </div>
  </div>
</section>
