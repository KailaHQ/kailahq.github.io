---
import type { Copy } from '../data/content'
import ScreenShot from './ScreenShot.astro'

interface Props {
  copy: Copy
}
const { copy } = Astro.props
const ep = copy.editpilot
---

<section id="editpilot" class="relative overflow-hidden border-y border-white/5 bg-ink-soft">
  <div
    class="pointer-events-none absolute right-0 top-0 h-[460px] w-[620px] translate-x-1/3 rounded-full bg-ember/8 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-[1240px] px-5 py-24 sm:px-8 sm:py-32">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-5">
        <div class="flex items-baseline gap-3">
          <span class="timecode text-ember">{ep.tc}</span>
          <span class="h-px w-16 bg-hairline/60"></span>
        </div>

        <h2 class="mt-6 whitespace-pre-line text-[clamp(2rem,4.2vw,3rem)]">{ep.title}</h2>
        <p class="mt-6 text-[15.5px] leading-[1.7] text-ash">{ep.body}</p>
        <p class="timecode mt-8 normal-case tracking-[0.08em]">{ep.note}</p>
      </div>

      <div class="reveal lg:col-span-7" style="--reveal-delay:110ms">
        <ScreenShot src={ep.shot} alt={ep.shotAlt} />

        <!-- The three guarantees sit under the capture; each answers a question
             people ask about an agent touching their work. -->
        <dl class="mt-5 grid gap-4 sm:grid-cols-3">
          {
            ep.points.map((p, i) => (
              <div class="rounded-xl border border-hairline/60 bg-panel/50 p-6">
                <span class="timecode text-ember">{String(i + 1).padStart(2, '0')}</span>
                <dt class="mt-2 font-display text-[15.5px] font-semibold tracking-[-0.02em] text-chalk">
                  {p.title}
                </dt>
                <dd class="mt-2 text-[13.5px] leading-relaxed text-ash">{p.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
