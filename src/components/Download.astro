---
import type { Copy } from '../data/content'
import { REPO, RELEASES_URL } from '../data/content'

interface Props {
  copy: Copy
}
const { copy } = Astro.props
const d = copy.download
---

<section id="download" class="relative overflow-hidden border-t border-white/5">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-gradient-to-b from-accent/8 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-[1240px] px-5 py-24 sm:px-8 sm:py-32">
    <div class="reveal max-w-[40rem]">
      <div class="flex items-baseline gap-3">
        <span class="timecode text-accent">{d.tc}</span>
        <span class="h-px w-16 bg-hairline/60"></span>
      </div>
      <h2 class="mt-6 text-[clamp(2.2rem,5vw,3.6rem)]">{d.title}</h2>
      <p class="mt-5 text-[15.5px] leading-[1.7] text-ash">{d.body}</p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {
        d.platforms.map((p, i) => (
          <a
            href={RELEASES_URL}
            data-dl={p.os.toLowerCase()}
            class="reveal group rounded-xl border border-hairline/70 bg-panel/70 p-7 transition-colors hover:border-accent/50 hover:bg-panel"
            style={`--reveal-delay:${i * 80}ms`}
          >
            <p class="font-display text-[20px] font-semibold tracking-[-0.03em]">{p.os}</p>
            <p class="mt-3 text-[13px] text-ash/75">{p.note}</p>
            <p class="mt-6 text-[14px] font-medium text-accent">
              {copy.nav.download}
              <span class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
            </p>
          </a>
        ))
      }

      <div class="reveal rounded-xl border border-hairline/70 bg-ink-soft/60 p-7" style="--reveal-delay:160ms">
        <p class="timecode">{d.reqTitle}</p>
        <ul class="mt-5 space-y-2.5">
          {
            d.reqs.map((r) => (
              <li class="text-[13.5px] leading-relaxed text-ash">{r}</li>
            ))
          }
        </ul>
        <p class="mt-6 border-t border-white/5 pt-5 text-[13px] leading-relaxed text-ash/75">
          {d.build}
        </p>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ repo: REPO }}>
    // Point each card straight at the newest installer. No size and no
    // version number: /releases/latest is always the newest build, so both
    // would be maintenance with nothing bought. The static markup
    // already links to the releases page, so a rate limit or an offline
    // visitor just gets the page as rendered.
    fetch(`https://api.github.com/repos/${repo}/releases/latest`, {
      headers: { Accept: 'application/vnd.github+json' },
    })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((rel) => {
        const assets = rel.assets || []
        const pick = (os) =>
          assets.find((a) =>
            os === 'windows' ? /\.exe$/i.test(a.name) : /\.dmg$/i.test(a.name),
          )
        for (const card of document.querySelectorAll('[data-dl]')) {
          const asset = pick(card.dataset.dl)
          if (!asset) continue
          card.href = asset.browser_download_url
        }
      })
      .catch(() => {})
  </script>
</section>
