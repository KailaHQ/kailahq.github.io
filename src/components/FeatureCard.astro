---
import type { Feature } from '../data/content'

interface Props {
  feature: Feature
  index: number
}
const { feature, index } = Astro.props
---

<article
  class="reveal group relative rounded-xl border border-hairline/60 bg-panel/40 p-8 transition-colors hover:border-accent/35 hover:bg-panel/70 sm:p-9"
  style={`--reveal-delay:${(index % 2) * 90}ms`}
>
  <div class="flex items-baseline gap-3">
    <span class="timecode text-accent">{feature.tc}</span>
    <span class="h-px flex-1 bg-hairline/60"></span>
    <span class="timecode">{feature.kicker}</span>
  </div>

  <h3 class="mt-6 text-[clamp(1.5rem,2.6vw,1.95rem)]">{feature.title}</h3>
  <p class="mt-4 text-[15px] leading-[1.7] text-ash">{feature.body}</p>

  <ul class="mt-6 space-y-2.5 border-t border-white/[0.06] pt-6">
    {
      feature.bullets.map((b) => (
        <li class="flex gap-3 text-[14px] leading-relaxed text-chalk/80">
          <span class="mt-[0.45rem] h-1.5 w-1.5 flex-none rotate-45 bg-accent/70" aria-hidden="true" />
          <span>{b}</span>
        </li>
      ))
    }
  </ul>
</article>
