---
import '../styles/global.css'
import { CANONICAL_PATH, type Copy, type Lang } from '../data/content'

interface Props {
  copy: Copy
  lang: Lang
}

const { copy, lang } = Astro.props

// Not Astro.url.pathname: this page is served at both `/` and `/kaila-edit/`,
// and both have to name the same canonical or search engines index them as two
// competing copies. See CANONICAL_PATH for why the deeper one wins.
const canonical = new URL(CANONICAL_PATH[lang], Astro.site).href
const canonicalEn = new URL(CANONICAL_PATH.en, Astro.site).href
const canonicalVi = new URL(CANONICAL_PATH.vi, Astro.site).href
const ogImage = new URL('/og.png', Astro.site).href
---

<!doctype html>
<html lang={copy.htmlLang} class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="alternate" hreflang="en" href={canonicalEn} />
    <link rel="alternate" hreflang="vi" href={canonicalVi} />
    <link rel="alternate" hreflang="x-default" href={canonicalEn} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0b" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..700&family=Be+Vietnam+Pro:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>

  <body class="grain">
    <!-- Scroll progress reads as a playhead scrubbing the page. -->
    <div
      id="playhead"
      class="fixed left-0 top-0 z-[70] h-px w-full origin-left scale-x-0 bg-accent shadow-[0_0_12px_var(--color-accent)]"
      aria-hidden="true"
    >
    </div>

    <slot />

    <script is:inline>
      // Scroll-reveal + playhead. Inline and tiny: the page has no other JS,
      // and both features degrade to "already visible" without it.
      ;(() => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
        const items = document.querySelectorAll('.reveal')

        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-in'))
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-in')
                  io.unobserve(e.target)
                }
              }
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
          )
          items.forEach((el) => io.observe(el))
        }

        const bar = document.getElementById('playhead')
        if (bar && !reduce) {
          let ticking = false
          const paint = () => {
            const max = document.documentElement.scrollHeight - innerHeight
            bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`
            ticking = false
          }
          addEventListener(
            'scroll',
            () => {
              if (!ticking) {
                ticking = true
                requestAnimationFrame(paint)
              }
            },
            { passive: true },
          )
          paint()
        }
      })()
    </script>
  </body>
</html>
